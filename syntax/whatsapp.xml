<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<language name="WhatsApp"
          section="Markup"
          version="2"
          kateversion="5.0"
          extensions="*.whatsapp;*.wa"
          mimetype="text/x-whatsapp-formatting"
          author="Community"
          license="MIT"
          indenter="normal">

  <highlighting>
    <contexts>

      <!-- ============================================================
           NORMAL TEXT
           ============================================================ -->
      <context name="Normal"
               attribute="Normal Text"
               lineEndContext="#stay">

        <!-- Quotes are only recognized at the start of a line. -->
        <RegExpr String="^&gt;\s?"
                 attribute="Quote Marker"
                 context="Quote Line"
                 column="0"/>

        <!-- Unordered lists: one level only. -->
        <RegExpr String="^(?:\*|-)\s+"
                 attribute="List Marker"
                 context="List Line"
                 column="0"/>

        <!-- Ordered lists: one level only. -->
        <RegExpr String="^\d+\.\s+"
                 attribute="Number Marker"
                 context="List Line"
                 column="0"/>

        <IncludeRules context="Inline"/>
      </context>


      <!-- ============================================================
           QUOTE LINE
           Structural nesting is intentionally not supported.
           Inline formatting is still allowed.
           ============================================================ -->
      <context name="Quote Line"
               attribute="Normal Text"
               lineEndContext="#pop">

        <IncludeRules context="Inline"/>
      </context>


      <!-- ============================================================
           LIST / ENUMERATION LINE
           Only one structural level is supported.
           ============================================================ -->
      <context name="List Line"
               attribute="Normal Text"
               lineEndContext="#pop">

        <IncludeRules context="Inline"/>
      </context>


      <!-- ============================================================
           INLINE FORMATTING

           Formatting with *, _ and ~ is stack-based.

           A delimiter only opens when:
             - it is immediately followed by non-whitespace content,
             - a valid closing delimiter exists later on the same line.

           Nested formatting must close in reverse order (LIFO).

           Triple backticks MUST be checked before a single backtick.
           ============================================================ -->
      <context name="Inline"
               attribute="Normal Text"
               lineEndContext="#stay">

        <!-- Multiline / block monospace. Delimiters may appear anywhere. -->
        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Inline monospace. -->
        <StringDetect String="`"
                      attribute="Code Marker"
                      context="Inline Code"/>

        <!-- Bold: *text* -->
        <RegExpr String="\*(?=\S)(?=[^\n]*\S\*)"
                 attribute="Bold Marker"
                 context="Bold"/>

        <!-- Strikethrough: ~text~ -->
        <RegExpr String="~(?=\S)(?=[^\n]*\S~)"
                 attribute="Strike Marker"
                 context="Strike"/>

        <!-- Italic: _text_ -->
        <RegExpr String="_(?=\S)(?=[^\n]*\S_)"
                 attribute="Italic Marker"
                 context="Italic"/>
      </context>


      <!-- ============================================================
           ONE ACTIVE FORMAT
           ============================================================ -->


      <!-- ------------------------------------------------------------
           BOLD: *...*
           ------------------------------------------------------------ -->
      <context name="Bold"
               attribute="Bold"
               lineEndContext="#pop">

        <!-- Block monospace always takes precedence. -->
        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close the current bold context. -->
        <RegExpr String="(?&lt;=\S)\*"
                 attribute="Bold Marker"
                 context="#pop"/>

        <!--
             Strike may only open if it closes before the outer *.
        -->
        <RegExpr String="~(?=\S)(?=[^*\n]*\S~)"
                 attribute="Strike Marker"
                 context="Bold Strike"/>

        <!--
             Italic may only open if it closes before the outer *.
        -->
        <RegExpr String="_(?=\S)(?=[^*\n]*\S_)"
                 attribute="Italic Marker"
                 context="Bold Italic"/>
      </context>


      <!-- ------------------------------------------------------------
           STRIKETHROUGH: ~...~
           ------------------------------------------------------------ -->
      <context name="Strike"
               attribute="Strike"
               lineEndContext="#pop">

        <!-- Block monospace always takes precedence. -->
        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close the current strike context. -->
        <RegExpr String="(?&lt;=\S)~"
                 attribute="Strike Marker"
                 context="#pop"/>

        <!--
             Bold may only open if it closes before the outer ~.
        -->
        <RegExpr String="\*(?=\S)(?=[^~\n]*\S\*)"
                 attribute="Bold Marker"
                 context="Strike Bold"/>

        <!--
             Italic may only open if it closes before the outer ~.
        -->
        <RegExpr String="_(?=\S)(?=[^~\n]*\S_)"
                 attribute="Italic Marker"
                 context="Strike Italic"/>
      </context>


      <!-- ------------------------------------------------------------
           ITALIC: _..._
           ------------------------------------------------------------ -->
      <context name="Italic"
               attribute="Italic"
               lineEndContext="#pop">

        <!-- Block monospace always takes precedence. -->
        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close the current italic context. -->
        <RegExpr String="(?&lt;=\S)_"
                 attribute="Italic Marker"
                 context="#pop"/>

        <!--
             Bold may only open if it closes before the outer _.
        -->
        <RegExpr String="\*(?=\S)(?=[^_\n]*\S\*)"
                 attribute="Bold Marker"
                 context="Italic Bold"/>

        <!--
             Strike may only open if it closes before the outer _.
        -->
        <RegExpr String="~(?=\S)(?=[^_\n]*\S~)"
                 attribute="Strike Marker"
                 context="Italic Strike"/>
      </context>


      <!-- ============================================================
           TWO ACTIVE FORMATS

           Context names preserve opening order.

           For example:

             Bold Italic

           means:

             * outer bold
             _ inner italic

           Only the innermost delimiter may close first.
           ============================================================ -->


      <!-- ------------------------------------------------------------
           * _ ... _ *
           ------------------------------------------------------------ -->
      <context name="Bold Italic"
               attribute="Bold Italic"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost italic. -->
        <RegExpr String="(?&lt;=\S)_"
                 attribute="Italic Marker"
                 context="#pop"/>

        <!--
             Strike must be fully contained before the inner _ closes.
        -->
        <RegExpr String="~(?=\S)(?=[^_\n]*\S~)"
                 attribute="Strike Marker"
                 context="Bold Italic Strike"/>
      </context>


      <!-- ------------------------------------------------------------
           * ~ ... ~ *
           ------------------------------------------------------------ -->
      <context name="Bold Strike"
               attribute="Bold Strike"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost strike. -->
        <RegExpr String="(?&lt;=\S)~"
                 attribute="Strike Marker"
                 context="#pop"/>

        <!--
             Italic must be fully contained before the inner ~ closes.
        -->
        <RegExpr String="_(?=\S)(?=[^~\n]*\S_)"
                 attribute="Italic Marker"
                 context="Bold Strike Italic"/>
      </context>


      <!-- ------------------------------------------------------------
           _ * ... * _
           ------------------------------------------------------------ -->
      <context name="Italic Bold"
               attribute="Bold Italic"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost bold. -->
        <RegExpr String="(?&lt;=\S)\*"
                 attribute="Bold Marker"
                 context="#pop"/>

        <!--
             Strike must be fully contained before the inner * closes.
        -->
        <RegExpr String="~(?=\S)(?=[^*\n]*\S~)"
                 attribute="Strike Marker"
                 context="Italic Bold Strike"/>
      </context>


      <!-- ------------------------------------------------------------
           _ ~ ... ~ _
           ------------------------------------------------------------ -->
      <context name="Italic Strike"
               attribute="Italic Strike"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost strike. -->
        <RegExpr String="(?&lt;=\S)~"
                 attribute="Strike Marker"
                 context="#pop"/>

        <!--
             Bold must be fully contained before the inner ~ closes.

             This is what makes:

               _~*text*~_

             valid for all three styles, while:

               _~*text~*_

             does NOT activate bold.
        -->
        <RegExpr String="\*(?=\S)(?=[^~\n]*\S\*)"
                 attribute="Bold Marker"
                 context="Italic Strike Bold"/>
      </context>


      <!-- ------------------------------------------------------------
           ~ * ... * ~
           ------------------------------------------------------------ -->
      <context name="Strike Bold"
               attribute="Bold Strike"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost bold. -->
        <RegExpr String="(?&lt;=\S)\*"
                 attribute="Bold Marker"
                 context="#pop"/>

        <!--
             Italic must be fully contained before the inner * closes.
        -->
        <RegExpr String="_(?=\S)(?=[^*\n]*\S_)"
                 attribute="Italic Marker"
                 context="Strike Bold Italic"/>
      </context>


      <!-- ------------------------------------------------------------
           ~ _ ... _ ~
           ------------------------------------------------------------ -->
      <context name="Strike Italic"
               attribute="Italic Strike"
               lineEndContext="#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Close innermost italic. -->
        <RegExpr String="(?&lt;=\S)_"
                 attribute="Italic Marker"
                 context="#pop"/>

        <!--
             Bold must be fully contained before the inner _ closes.
        -->
        <RegExpr String="\*(?=\S)(?=[^_\n]*\S\*)"
                 attribute="Bold Marker"
                 context="Strike Italic Bold"/>
      </context>


      <!-- ============================================================
           THREE ACTIVE FORMATS

           All six possible opening orders are represented.

           No fourth formatting context can be opened because *, _ and ~
           are already active.

           Only the innermost delimiter can close the current context.
           This enforces proper stack / LIFO ordering.
           ============================================================ -->


      <!-- ------------------------------------------------------------
           * _ ~ ... ~ _ *
           ------------------------------------------------------------ -->
      <context name="Bold Italic Strike"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Strike is innermost. -->
        <RegExpr String="(?&lt;=\S)~"
                 attribute="Strike Marker"
                 context="#pop"/>
      </context>


      <!-- ------------------------------------------------------------
           * ~ _ ... _ ~ *
           ------------------------------------------------------------ -->
      <context name="Bold Strike Italic"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Italic is innermost. -->
        <RegExpr String="(?&lt;=\S)_"
                 attribute="Italic Marker"
                 context="#pop"/>
      </context>


      <!-- ------------------------------------------------------------
           _ * ~ ... ~ * _
           ------------------------------------------------------------ -->
      <context name="Italic Bold Strike"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Strike is innermost. -->
        <RegExpr String="(?&lt;=\S)~"
                 attribute="Strike Marker"
                 context="#pop"/>
      </context>


      <!-- ------------------------------------------------------------
           _ ~ * ... * ~ _
           ------------------------------------------------------------ -->
      <context name="Italic Strike Bold"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Bold is innermost. -->
        <RegExpr String="(?&lt;=\S)\*"
                 attribute="Bold Marker"
                 context="#pop"/>
      </context>


      <!-- ------------------------------------------------------------
           ~ * _ ... _ * ~
           ------------------------------------------------------------ -->
      <context name="Strike Bold Italic"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Italic is innermost. -->
        <RegExpr String="(?&lt;=\S)_"
                 attribute="Italic Marker"
                 context="#pop"/>
      </context>


      <!-- ------------------------------------------------------------
           ~ _ * ... * _ ~
           ------------------------------------------------------------ -->
      <context name="Strike Italic Bold"
               attribute="Bold Italic Strike"
               lineEndContext="#pop#pop#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="Code Block"/>

        <!-- Bold is innermost. -->
        <RegExpr String="(?&lt;=\S)\*"
                 attribute="Bold Marker"
                 context="#pop"/>
      </context>


      <!-- ============================================================
           INLINE MONOSPACE: `text`

           Inline monospace does not process any additional formatting.

           Triple backticks have higher priority and switch to block
           monospace.
           ============================================================ -->
      <context name="Inline Code"
               attribute="Inline Code"
               lineEndContext="#pop">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="#pop!Code Block"/>

        <DetectChar char="`"
                    attribute="Code Marker"
                    context="#pop"/>
      </context>


      <!-- ============================================================
           BLOCK / MULTILINE MONOSPACE: ```text```

           This is an exclusive context.

           While active, NO other WhatsApp formatting is interpreted.

           In particular:
             - no bold,
             - no italic,
             - no strikethrough,
             - no inline monospace,
             - no quotes,
             - no lists,
             - no enumerations.

           The only recognized token is the closing triple-backtick
           delimiter.

           Opening and closing delimiters may appear anywhere in a line.
           ============================================================ -->
      <context name="Code Block"
               attribute="Code Block"
               lineEndContext="#stay">

        <StringDetect String="```"
                      attribute="Code Fence"
                      context="#pop"/>
      </context>

    </contexts>


    <itemDatas>

      <!-- ============================================================
           NORMAL TEXT
           ============================================================ -->
      <itemData name="Normal Text"
                defStyleNum="dsNormal"/>


      <!-- ============================================================
           SINGLE FORMAT
           ============================================================ -->
      <itemData name="Bold"
                defStyleNum="dsNormal"
                bold="true"/>

      <itemData name="Italic"
                defStyleNum="dsNormal"
                italic="true"/>

      <itemData name="Strike"
                defStyleNum="dsNormal"
                strikeOut="true"/>


      <!-- ============================================================
           TWO COMBINED FORMATS
           ============================================================ -->
      <itemData name="Bold Italic"
                defStyleNum="dsNormal"
                bold="true"
                italic="true"/>

      <itemData name="Bold Strike"
                defStyleNum="dsNormal"
                bold="true"
                strikeOut="true"/>

      <itemData name="Italic Strike"
                defStyleNum="dsNormal"
                italic="true"
                strikeOut="true"/>


      <!-- ============================================================
           THREE COMBINED FORMATS
           ============================================================ -->
      <itemData name="Bold Italic Strike"
                defStyleNum="dsNormal"
                bold="true"
                italic="true"
                strikeOut="true"/>


      <!-- ============================================================
           MONOSPACE
           ============================================================ -->
      <itemData name="Inline Code"
                defStyleNum="dsVerbatimString"
                spellChecking="false"/>

      <itemData name="Code Block"
                defStyleNum="dsVerbatimString"
                spellChecking="false"/>


      <!-- ============================================================
           FORMAT MARKERS
           ============================================================ -->
      <itemData name="Bold Marker"
                defStyleNum="dsOperator"
                bold="true"/>

      <itemData name="Italic Marker"
                defStyleNum="dsOperator"/>

      <itemData name="Strike Marker"
                defStyleNum="dsOperator"
                strikeOut="true"/>

      <itemData name="Code Marker"
                defStyleNum="dsSpecialChar"/>

      <itemData name="Code Fence"
                defStyleNum="dsSpecialString"
                bold="true"/>


      <!-- ============================================================
           STRUCTURAL MARKERS
           ============================================================ -->
      <itemData name="Quote Marker"
                defStyleNum="dsInformation"
                bold="true"/>

      <itemData name="List Marker"
                defStyleNum="dsKeyword"
                bold="true"/>

      <itemData name="Number Marker"
                defStyleNum="dsDecVal"
                bold="true"/>

    </itemDatas>
  </highlighting>


  <general>
    <keywords casesensitive="1"/>
    <folding indentationsensitive="0"/>
  </general>

</language>
